# Salin file ini menjadi contracts/.env lalu isi nilainya. File .env tidak ikut repo.
# Variabel di bawah hanya dipakai untuk deploy dan verifikasi di Sepolia (progress 3).
# `npx hardhat test` memakai jaringan Hardhat lokal dan tidak membutuhkan file .env.

# URL RPC Ethereum Sepolia dari Alchemy atau Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/ganti-dengan-api-key-alchemy

# Private key dompet operator: 64 karakter heksadesimal dengan awalan 0x.
# Pakai dompet khusus testnet yang hanya berisi ETH Sepolia, jangan dompet pribadi.
OPERATOR_PRIVATE_KEY=ganti-dengan-private-key-dompet-operator

# API key Etherscan untuk verifikasi kontrak (satu key berlaku juga untuk Sepolia)
ETHERSCAN_API_KEY=ganti-dengan-api-key-etherscan
