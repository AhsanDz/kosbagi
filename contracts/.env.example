# Salin file ini menjadi contracts/.env lalu isi nilainya. File .env tidak ikut repo.
# Variabel di bawah hanya dipakai untuk deploy dan verifikasi di Sepolia.
# `npx hardhat test` memakai jaringan Hardhat lokal dan tidak membutuhkan file .env.
# Langkah lengkap: docs/kontrak/deploy-sepolia.md

# URL RPC Ethereum Sepolia dari Alchemy atau Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/ganti-dengan-api-key-alchemy

# Private key dompet admin: 64 karakter heksadesimal dengan awalan 0x.
# Pemegang DEFAULT_ADMIN_ROLE dan PAUSER_ROLE. Menandatangani deploy dan pencatatan
# dokumen penerbitan. Hanya dipakai skrip di folder contracts/, jangan pernah
# disalin ke backend/.env. Pakai dompet khusus testnet, jangan dompet pribadi.
ADMIN_PRIVATE_KEY=ganti-dengan-private-key-dompet-admin

# Private key dompet operator: 64 karakter heksadesimal dengan awalan 0x.
# Dompet transaksi harian backend (juga ada di backend/.env). Di folder ini hanya
# dipakai untuk memastikan alamat operator di ignition/parameters/sepolia.json
# benar; skrip deploy tidak mengirim transaksi dari dompet ini.
OPERATOR_PRIVATE_KEY=ganti-dengan-private-key-dompet-operator

# API key Etherscan untuk verifikasi kontrak (satu key berlaku juga untuk Sepolia). Juga dipakai
# npm run links:sepolia untuk membaca event lewat API Etherscan, karena RPC gratis membatasi eth_getLogs.
ETHERSCAN_API_KEY=ganti-dengan-api-key-etherscan

# Opsional, khusus gladi demo di Sepolia: label deploy kontrak baru, mis. gladi1. Huruf kecil,
# angka, dan tanda hubung, 1 sampai 20 karakter. Hasilnya deployments/sepolia-<label>.json dan
# jejak ignition/deployments/sepolia-smr01-<label>/, keduanya tidak di-commit. Biarkan kosong
# untuk deploy demo akhir (deployments/sepolia.json). Lebih aman diisi di terminal daripada di
# file ini, supaya tidak terbawa ke deploy demo akhir.
# DEPLOY_LABEL=

# Opsional, khusus gladi di Hardhat node lokal (chain 31337): folder lain berisi
# tiga file dokumen penerbitan dengan nama yang sama. Ditolak saat deploy Sepolia,
# yang selalu membaca docs/bisnis/dokumen-penerbitan/.
# ISSUANCE_DOCS_DIR=
