{
  "name": "kosbagi-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Smart contract KosBagi (KosToken, KosLedger, KosVoting) dengan Hardhat 3 dan OpenZeppelin Contracts 5",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:production": "hardhat test --build-profile production",
    "coverage": "hardhat test --coverage",
    "typecheck": "hardhat build && tsc --noEmit",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.13",
    "@nomicfoundation/hardhat-ignition": "3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.1.2",
    "@nomicfoundation/hardhat-mocha": "4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@nomicfoundation/hardhat-typechain": "3.1.3",
    "@nomicfoundation/hardhat-verify": "3.1.4",
    "@nomicfoundation/ignition-core": "3.1.11",
    "@types/chai": "5.2.3",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "chai": "6.3.0",
    "ethers": "6.17.0",
    "hardhat": "3.21.1",
    "mocha": "12.0.3",
    "typescript": "6.0.3"
  }
}
