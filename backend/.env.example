# Contoh konfigurasi backend KosBagi untuk pengembangan lokal.
# Salin menjadi .env di folder backend:   copy .env.example .env   (Windows)
#                                         cp .env.example .env     (macOS/Linux)
# File .env TIDAK BOLEH di-commit. Semua nilai di sini contoh dan hanya untuk laptop sendiri.

# --- Server ---
# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origin frontend yang boleh memanggil API (Next.js lokal). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (dijalankan lewat docker-compose.yml di root repo: npm run db:up) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://kosbagi:kosbagi@localhost:5432/kosbagi?schema=public

# --- Redis (antrean job blockchain BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Autentikasi ---
# Kunci penandatangan JWT, minimal 32 karakter. Nilai ini hanya untuk laptop sendiri;
# lingkungan demo wajib memakai nilai acak lain.
JWT_SECRET=contoh-lokal-saja-ganti-sebelum-deploy-kosbagi-2026

# --- Midtrans sandbox ---
# Server key dari dashboard sandbox (Settings > Access Keys), wajib berawalan SB-Mid-server-.
# Rahasia: hanya ada di file ini, tidak pernah sampai ke peramban.
# Bila kosong, server tetap jalan dan endpoint pembayaran membalas 503 MIDTRANS_NOT_CONFIGURED.
MIDTRANS_SERVER_KEY=

# --- Blockchain (hanya dipakai worker, mulai progress 3; server API tidak butuh) ---
# URL RPC Sepolia dari Alchemy atau Infura, ditambah penyedia cadangan.
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_FALLBACK=
# Private key dompet operator: 64 karakter heksadesimal berawalan 0x. Khusus testnet.
OPERATOR_PRIVATE_KEY=
# Seed dompet kustodian investor. Khusus testnet.
CUSTODIAL_WALLET_MNEMONIC=
# Alamat kontrak hasil deploy.
KOS_TOKEN_ADDRESS=
KOS_LEDGER_ADDRESS=
