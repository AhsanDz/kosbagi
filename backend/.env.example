# Contoh konfigurasi backend KosBagi untuk pengembangan lokal.
# Salin menjadi .env di folder backend:   copy .env.example .env   (Windows)
#                                         cp .env.example .env     (macOS/Linux)
# File .env TIDAK BOLEH di-commit. Semua nilai di sini contoh dan hanya untuk laptop sendiri.

# --- Server ---
# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origin frontend yang boleh memanggil API (Next.js lokal). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:3000
# Proxy yang dipercaya saat membaca IP klien untuk rate limit (header X-Forwarded-For).
# Kosong = hanya proxy di laptop ini (ngrok dan Next.js lokal), cocok untuk demo lokal.
# Di Railway isi 1. Bentuk lain: daftar alamat/CIDR dipisah koma, atau false. Nilai true ditolak.
TRUST_PROXY=

# --- PostgreSQL (dijalankan lewat docker-compose.yml di root repo: npm run db:up) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://kosbagi:kosbagi@localhost:5432/kosbagi?schema=public

# --- Redis (antrean job blockchain BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Autentikasi ---
# Kunci penandatangan JWT, minimal 32 karakter. Nilai ini hanya untuk laptop sendiri;
# lingkungan demo wajib memakai nilai acak lain. Saat NODE_ENV=production nilai contoh ini ditolak.
# Membuat nilai acak:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=contoh-lokal-saja-ganti-sebelum-deploy-kosbagi-2026

# --- Midtrans sandbox ---
# Server key dari dashboard sandbox (Settings > Access Keys), wajib berawalan SB-Mid-server-.
# Rahasia: hanya ada di file ini, tidak pernah sampai ke peramban.
# Bila kosong, server tetap jalan dan endpoint pembayaran membalas 503 MIDTRANS_NOT_CONFIGURED.
MIDTRANS_SERVER_KEY=

# --- Blockchain (worker jalur 3, mulai progress 3) ---
# URL RPC Sepolia dari Alchemy atau Infura, ditambah penyedia cadangan.
# Untuk Hardhat node lokal: http://127.0.0.1:8545
SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL_FALLBACK=
# Jaringan yang diharapkan worker. Kosong = 11155111 (Sepolia). Hardhat lokal: 31337.
# Worker menolak jalan bila jaringan RPC berbeda.
CHAIN_ID=
# Private key dompet operator: 64 karakter heksadesimal berawalan 0x. Khusus testnet.
# Kunci dompet admin (deploy kontrak) TIDAK PERNAH ditaruh di file ini, hanya di contracts/.env.
OPERATOR_PRIVATE_KEY=
# Mnemonic BIP-39 sumber alamat dompet kustodian investor (path m/44'/60'/0'/0/<indeks>).
# Dipakai server API saat admin menyetujui KYC; bila kosong, persetujuan KYC dibalas 503.
# Khusus testnet. Jangan memakai mnemonic bawaan Hardhat, karena alamatnya sama dengan akun
# deploy dan operator. Buat yang baru, mis.:
#   node -e "import('ethers').then((e) => console.log(e.Wallet.createRandom().mnemonic.phrase))"
CUSTODIAL_WALLET_MNEMONIC=
# Alamat kontrak hasil deploy (contracts/deployments/). KOS_LEDGER_ADDRESS juga tampil di kuitansi.
KOS_TOKEN_ADDRESS=
KOS_LEDGER_ADDRESS=

# --- Nota biaya (mulai progress 4) ---
# Folder file nota yang diunggah pengelola. Path relatif dibaca dari folder backend/.
# Kosong = backend/uploads (sudah diabaikan git). Hanya hash SHA-256 nota yang dicatat on-chain.
UPLOAD_DIR=
