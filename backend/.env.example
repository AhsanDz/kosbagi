# Contoh konfigurasi backend KosBagi untuk pengembangan lokal.
# Salin menjadi .env di folder backend:   copy .env.example .env   (Windows)
#                                         cp .env.example .env     (macOS/Linux)
# File .env TIDAK BOLEH di-commit. Semua nilai di sini contoh dan hanya untuk laptop sendiri.

# --- Server ---
# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origin frontend yang boleh memanggil API (Next.js lokal). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (dijalankan lewat docker-compose.yml di root repo: npm run db:up) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://kosbagi:kosbagi@localhost:5432/kosbagi?schema=public

# --- Redis (antrean job blockchain BullMQ, dipakai mulai progress 2) ---
REDIS_URL=redis://localhost:6379
