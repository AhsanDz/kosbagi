# Salin file ini menjadi .env.local lalu sesuaikan nilainya.
# Hanya variabel berawalan NEXT_PUBLIC_ yang sampai ke peramban, jadi jangan
# pernah menaruh server key Midtrans atau private key dompet di sini.

# Alamat API backend KosBagi (Express).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Client key Midtrans sandbox (berawalan SB-Mid-client-), dipakai snap.js.
# Boleh sampai ke peramban. Kalau kosong, tombol bayar menampilkan pesan.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
