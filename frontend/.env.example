# Salin file ini menjadi .env.local lalu sesuaikan nilainya.
# Hanya variabel berawalan NEXT_PUBLIC_ yang sampai ke peramban, jadi jangan
# pernah menaruh server key Midtrans atau private key dompet di sini.

# Alamat API backend KosBagi (Express), tanpa /api. Ikut tertanam saat build,
# jadi setelah mengubahnya di hosting, build ulang frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Client key Midtrans sandbox (berawalan SB-Mid-client-), dipakai snap.js.
# Boleh sampai ke peramban. Kalau kosong, tombol bayar menampilkan pesan.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Isi true hanya bila frontend berjalan di balik proxy yang menimpa header
# X-Forwarded-Host dan X-Forwarded-For sendiri (mis. Vercel). Saat lokal biarkan
# kosong: tanpa proxy, header itu bisa dipalsukan pengunjung.
TRUST_PROXY_HEADERS=
